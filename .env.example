# Backend1 — admin, maids/jobs, blog, contact, analytics
VITE_BACKEND1_URL=https://api.backendpickmymaid.site

# Backend2 — auth, payment
VITE_BACKEND2_URL=https://api.backendpickmymaid.site

# Both point at the same origin — in production both backends sit behind
# the same host (nginx/k8s ingress routes by path prefix, see
# Pick_Back/nginx/nginx.conf), and every request path below already
# starts with /api/v1 or /api/v2, so this resolves to
# https://api.backendpickmymaid.site/api/v1/...
#
# For local dev against separately-running backends instead, split them:
# VITE_BACKEND1_URL=http://localhost:8080
# VITE_BACKEND2_URL=http://localhost:8081

# Base URL for DO Spaces media keys (profile photos, videos)
VITE_MEDIA_BASE_URL=https://pickmymaidbucket.sfo3.cdn.digitaloceanspaces.com
